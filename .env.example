# Copy to .env and fill in real values. .env is gitignored.

# --- Postgres ---
POSTGRES_USER=filmybox
POSTGRES_PASSWORD=filmybox
POSTGRES_DB=filmybox
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://filmybox:filmybox@postgres:5432/filmybox

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Data source API keys (fill in as you sign up) ---
TMDB_API_KEY=
YOUTUBE_API_KEY=
OMDB_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=filmybox/0.1 by yourusername

# --- Prefect Cloud ---
# From a Prefect Cloud workspace: Settings -> API Keys, and the workspace's API URL
PREFECT_API_KEY=
PREFECT_API_URL=
